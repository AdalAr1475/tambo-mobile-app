# Tambo IA · texto libre en "Arma tu plan" (It9). Copia este archivo como .env y reinicia
# `npx expo start`. Si dejas todo vacío, la pantalla funciona solo con el formulario.

# Modo directo (desarrollo): la app llama a Gemini con esta key.
# Créala en Google AI Studio (https://aistudio.google.com) → Get API key, idealmente en un
# proyecto SIN facturación (solo nivel gratuito).
# OJO: todo EXPO_PUBLIC_* se copia dentro del bundle de la app; quien tenga la app puede verla.
EXPO_PUBLIC_GEMINI_API_KEY=

# Opcional: otro modelo de Gemini (por defecto gemini-3.5-flash-lite).
EXPO_PUBLIC_GEMINI_MODEL=

# Opcional (presentación): URL del proxy de proxy/ (ver proxy/README.md). Si está definida,
# la app usa el proxy y la key de arriba no hace falta (déjala vacía para no incluirla en el bundle).
EXPO_PUBLIC_AI_PROXY_URL=
